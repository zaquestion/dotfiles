From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaq Question <zaquestion@gmail.com>
Subject: [PATCH] publish focused client pid for focused_dir

Write the currently focused client's pid to
$XDG_RUNTIME_DIR/dwl/focused.pid on every focus change. Wayland has no
cross-client equivalent of X11's _NET_ACTIVE_WINDOW + _NET_WM_PID, so
external tools can't otherwise learn which window is focused or its pid.
The `focused_dir` script reads this file to resolve the active window's
working directory (used by the `footcwd` launcher).

Handles both xdg-shell (via wl_client_get_credentials) and XWayland
(via wlr_xwayland_surface->pid). A cleared focus writes pid 0.
---
 dwl.c | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/dwl.c b/dwl.c
index 0000000..0000000 100644
--- a/dwl.c
+++ b/dwl.c
@@ -8,6 +8,7 @@
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <sys/stat.h>
 #include <sys/wait.h>
 #include <time.h>
 #include <unistd.h>
@@ -307,6 +308,7 @@
 static void dwl_ipc_output_set_tags(struct wl_client *client, struct wl_resource *resource, uint32_t tagmask, uint32_t toggle_tagset);
 static void dwl_ipc_output_release(struct wl_client *client, struct wl_resource *resource);
 static void focusclient(Client *c, int lift);
+static void writefocuspid(Client *c);
 static void focusmon(const Arg *arg);
 static void focusstack(const Arg *arg);
 static Client *focustop(Monitor *m);
@@ -1574,6 +1576,48 @@
 	wl_resource_destroy(resource);
 }
 
+static void
+writefocuspid(Client *c)
+{
+	/* Publish the focused client's pid to $XDG_RUNTIME_DIR/dwl/focused.pid so
+	 * external tools (e.g. focused_dir) can find the active window's cwd. This
+	 * is dwl's answer to X11's _NET_ACTIVE_WINDOW + _NET_WM_PID. */
+	static char path[256];
+	static int havepath = 0;
+	char buf[16];
+	const char *rundir;
+	pid_t pid = 0;
+	int n;
+	FILE *f;
+
+	if (!(rundir = getenv("XDG_RUNTIME_DIR")))
+		return;
+	if (!havepath) {
+		n = snprintf(path, sizeof path, "%s/dwl", rundir);
+		if (n < 0 || n >= (int)sizeof path)
+			return;
+		mkdir(path, 0700);
+		snprintf(path + n, sizeof path - n, "/focused.pid");
+		havepath = 1;
+	}
+
+	if (c) {
+#ifdef XWAYLAND
+		if (client_is_x11(c))
+			pid = c->surface.xwayland->pid;
+		else
+#endif
+			wl_client_get_credentials(c->surface.xdg->client->client,
+					&pid, NULL, NULL);
+	}
+
+	if (!(f = fopen(path, "w")))
+		return;
+	snprintf(buf, sizeof buf, "%d\n", (int)pid);
+	fputs(buf, f);
+	fclose(f);
+}
+
 void
 focusclient(Client *c, int lift)
 {
@@ -1632,6 +1676,7 @@
 		}
 	}
 	printstatus();
+	writefocuspid(c);
 
 	if (!c) {
 		/* With no client, all we have left is to clear focus */

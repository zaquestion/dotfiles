// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    //"height": 40, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 1, // Gaps between modules (4px)
    "reload_style_on_change": true, // restyle live on save, imports included
    // Choose the order of the modules
    // custom/media is gone: it ran the stock theme's mediaplayer.py, which was
    // never in this repo and never on disk, so the module produced nothing but
    // a swallowed stderr. Bringing it back means tracking that script plus
    // python3-gi and playerctl, for a media player that isn't installed here.
    "modules-left": [
	"dwl/tags"
    ],
    "modules-center": [
        "dwl/window"
    ],
    "modules-right": [
        "custom/voxtype",
        "mpd",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "keyboard-state",
        "battery",
        "battery#bat2",
        "clock",
        "tray",
        "custom/power"
    ],
    "dwl/window": {
        // {layout} is the dwl layout symbol from config.h: "[]=" tile, "[M]"
        // monocle, "><>" the floating layout. A trailing "~" ("[]=~") means the
        // focused window itself was floated with Mod+Shift+Space. dwl publishes
        // that as its own ipc event but waybar 0.12 ignores it, so patch 0004
        // (patches/dwl) folds it into the symbol instead.
        "format": "{layout} {title}"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} {format_source}",
        "format-muted": "󰅶 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    // Dictation state, so a toggle-style push-to-talk has something to say
    // whether it's listening. Without this the only feedback that mod-slash
    // armed the mic is the text showing up (or not) some seconds later.
    //
    // --follow makes voxtype hold the pipe open and emit a line per state
    // change, so this is event-driven -- no "interval" key, nothing polling.
    // It prints {"text","alt","class","tooltip"}, and the class is what the
    // .recording/.transcribing rules in style.css hang off. Icons come from
    // [status] icon_theme = "nerd-font" in ~/.config/voxtype/config.toml,
    // which resolves to the U+F1xx FontAwesome range the rest of the bar uses.
    //
    // Clicking is the same toggle as the keybinding, not voxtype's suggested
    // `systemctl --user restart voxtype` -- the daemon is started by
    // ~/scripts/dwlstart here, not by systemd.
    "custom/voxtype": {
        "exec": "$HOME/.local/bin/voxtype status --follow --format json 2> /dev/null",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "$HOME/scripts/dictate"
    },
    // power_menu.xml is tracked next to this file now, so it is symlinked into
    // place with everything else. Without it waybar still draws the icon and
    // the click silently does nothing, which is how this sat until now.
    //
    // The actions are systemctl verbs rather than the stock theme's bare
    // `shutdown`/`reboot`: those are /sbin binaries that want root, so clicking
    // them from a user session fails. systemctl routes the same request through
    // logind, which polkit already grants to a logged-in local user -- the same
    // path the suspend entry was using all along. Hibernate is left out; it
    // needs swap sized for it, and there is none here.
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"lock": "swaylock",
			"suspend": "systemctl suspend",
			"reboot": "systemctl reboot",
			"shutdown": "systemctl poweroff"
		}
    },
    "dwl/tags": {
	    "num-tags": 9,
	    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
    }
}
